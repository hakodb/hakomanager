{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HakoManager",
  "version": "0.1.0",
  "identifier": "com.hakodb.hakomanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HakoManager",
        "width": 1440,
        "height": 900,
        "decorations": true,
        "resizable": true,
        "minWidth": 1024,
        "minHeight": 640
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png"]
  }
}
