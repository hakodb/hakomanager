{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HakoManager",
  "version": "0.1.7",
  "identifier": "com.hakodb.hakomanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HakoManager",
        "width": 1440,
        "height": 900,
        "decorations": true,
        "resizable": true,
        "minWidth": 1024,
        "minHeight": 640
      }
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/hakodb/hakomanager/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgyNDI4RUZDQjNEMEM1QjUKUldTMXhkQ3ovSTVDZ2gxZGl0ZDNJNVFQM1o3QzNacGxjZkF4ZzRENWEwM245SFpUWkpCMWs4UTkK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "HakoDB",
    "shortDescription": "HakoDB desktop manager",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
